---
import StoryCard from './StoryCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, CATEGORY_IDS } from '../data/site';
import { dateKey, editionPath, formatDate, getDaily, type Language } from '../lib/content';

const { language } = Astro.props as { language: Language };
const isZh = language === 'zh';
const entries = await getDaily(language);
const latest = entries[0];
const recent = entries.slice(1, 7);
const prefix = isZh ? '' : '/en';
const alternatePath = isZh ? '/en/' : '/';
const title = isZh ? 'Concitech AI 日报｜每日 AI 新闻编辑摘要' : 'Concitech AI Daily | An editorial AI news digest';
const description = isZh
  ? '面向科技读者的中英双语 AI 日报：每天筛选模型、产品、研究、开发工具、商业、政策与安全领域的重要变化。'
  : 'A bilingual daily editorial digest covering the most meaningful changes in AI models, products, research, tools, business, policy and security.';
---

<BaseLayout {title} {description} {language} canonicalPath={isZh ? '/' : '/en/'} {alternatePath}>
  {latest ? (
    <>
      <section class="lead shell">
        <div class="lead-copy">
          <p class="eyebrow">{isZh ? '每日编辑摘要 · 太平洋时间' : 'Daily editorial briefing · Pacific Time'}</p>
          <h1>{isZh ? <>今天的<br /><em>AI 信号</em></> : <>Today’s<br /><em>AI signals</em></>}</h1>
          <p class="dek">{latest.data.description}</p>
          <div class="actions">
            <a class="button primary" href={editionPath(language, latest.data.datePT)}>{isZh ? '阅读今日日报' : 'Read today’s edition'} <span>↗</span></a>
            <span class="issue mono">№ {dateKey(latest.data.datePT).replaceAll('-', '')}</span>
          </div>
        </div>
        <a class="cover-link" href={editionPath(language, latest.data.datePT)} aria-label={latest.data.title}>
          <img src={latest.data.cover} alt="" width="1200" height="630" fetchpriority="high" />
          <span class="cover-date mono">{formatDate(latest.data.datePT, language)}</span>
        </a>
      </section>

      <section class="shell">
        <div class="section-rule mono"><span>{isZh ? '近日出版' : 'Recent editions'}</span><span>{recent.length + 1} / 30</span></div>
        <div class="edition-grid">
          {recent.map((entry, index) => <StoryCard {entry} {language} featured={index === 0} />)}
        </div>
        <p class="more"><a class="button" href={`${prefix}/archive/`}>{isZh ? '查看全部归档' : 'Browse the archive'} →</a></p>
      </section>

      <section class="topics shell">
        <div class="section-rule mono"><span>{isZh ? '固定栏目' : 'Coverage desk'}</span><span>01—07</span></div>
        <div class="topic-list">
          {CATEGORY_IDS.map((id) => (
            <a href={`${prefix}/topics/${id}/`}>
              <span class="mono">{CATEGORIES[id].index}</span>
              <strong>{CATEGORIES[id][language]}</strong>
              <span>↗</span>
            </a>
          ))}
        </div>
      </section>
    </>
  ) : (
    <section class="empty shell">
      <p class="eyebrow">Concitech AI Editorial</p>
      <h1>{isZh ? '首期正在编辑。' : 'The first edition is in the works.'}</h1>
    </section>
  )}
</BaseLayout>

<style>
  .lead { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(320px, .95fr); gap: clamp(30px, 6vw, 90px); align-items: center; min-height: calc(100vh - 75px); padding-block: 54px; }
  .lead h1 { margin: 26px 0 30px; }
  .lead h1 em { color: var(--cobalt); font-weight: inherit; }
  .dek { max-width: 650px; color: #3f4b53; font-family: 'Newsreader', 'Noto Sans SC', serif; font-size: clamp(1.3rem, 2vw, 1.7rem); line-height: 1.35; }
  .actions { display: flex; align-items: center; gap: 22px; margin-top: 38px; }
  .issue { color: var(--muted); }
  .cover-link { position: relative; display: block; transform: rotate(1.5deg); box-shadow: 18px 18px 0 var(--ink); transition: transform .2s ease; }
  .cover-link:hover { transform: rotate(0) translateY(-5px); }
  .cover-link img { aspect-ratio: 1200 / 630; object-fit: cover; background: var(--cobalt); }
  .cover-date { position: absolute; right: 16px; bottom: 12px; color: white; }
  .more { margin-top: 34px; text-align: right; }
  .topic-list { border-top: 1px solid var(--ink); }
  .topic-list a { display: grid; grid-template-columns: 60px 1fr auto; align-items: center; gap: 20px; border-bottom: 1px solid var(--ink); padding: 14px 4px; text-decoration: none; transition: padding .15s ease, background .15s ease; }
  .topic-list a:hover { padding-inline: 14px; color: white; background: var(--cobalt); }
  .topic-list strong { font-family: 'Newsreader', 'Noto Sans SC', serif; font-size: clamp(1.5rem, 3vw, 2.5rem); }
  .empty { min-height: 70vh; padding-block: 100px; }
  @media (max-width: 900px) { .lead { grid-template-columns: 1fr; min-height: auto; } .cover-link { margin: 10px 12px 24px 0; } }
</style>
