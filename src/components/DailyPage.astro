---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../data/site';
import { dateKey, editionPath, formatCST, formatDate, type DailyEntry, type Language } from '../lib/content';

const { entry, language } = Astro.props as { entry: DailyEntry; language: Language };
const isZh = language === 'zh';
const date = dateKey(entry.data.datePT);
const alternateLanguage = isZh ? 'en' : 'zh';
const canonicalPath = editionPath(language, date);
const alternatePath = editionPath(alternateLanguage, date);
const { Content, headings } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} {language} {canonicalPath} {alternatePath} image={entry.data.cover} article>
  <article>
    <header class="edition-head shell">
      <div class="edition-meta">
        <p class="eyebrow">{isZh ? '每日编辑摘要' : 'Daily editorial briefing'}</p>
        <p class="issue mono">№ {date.replaceAll('-', '')}</p>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="description">{entry.data.description}</p>
      <div class="dateline">
        <div><span class="mono">{isZh ? '归属日期 · PT' : 'Edition date · PT'}</span><strong>{formatDate(entry.data.datePT, language)}</strong></div>
        <div><span class="mono">{isZh ? '发布时间 · CST' : 'Published · CST'}</span><strong>{formatCST(entry.data.publishedAtCST, language)}</strong></div>
        <div><span class="mono">{isZh ? '编辑' : 'By'}</span><strong>{entry.data.author}</strong></div>
      </div>
      <div class="category-row">
        {entry.data.categories.map((id) => <a class="category-chip" href={`${isZh ? '' : '/en'}/topics/${id}/`}>{CATEGORIES[id][language]}</a>)}
      </div>
    </header>

    <div class="article-shell shell">
      {headings.length > 2 && (
        <aside class="contents">
          <p class="mono">{isZh ? '本期目录' : 'In this edition'}</p>
          <ol>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
        </aside>
      )}
      <div class="prose"><Content /></div>
    </div>

    <footer class="edition-footer shell">
      <p>{isZh ? '本期内容由 Concitech AI 编辑部借助自动化工具聚合、筛选和翻译，并经规则校验后发布。发现错误？' : 'This edition was aggregated, selected and translated with automation, then checked against our publishing rules.'}</p>
      <a class="button" href={isZh ? '/contact/' : '/en/contact/'}>{isZh ? '提交纠错' : 'Submit a correction'} →</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .edition-head { padding: 72px 0 58px; border-bottom: 7px solid var(--ink); }
  .edition-meta { display: flex; justify-content: space-between; border-top: 1px solid var(--ink); padding-top: 9px; }
  .edition-head h1 { max-width: 1100px; margin: 60px 0 32px; font-size: clamp(3.4rem, 8vw, 7.5rem); }
  .description { max-width: 850px; color: #3c4951; font-family: 'Newsreader', 'Noto Sans SC', serif; font-size: clamp(1.3rem, 2vw, 1.7rem); line-height: 1.4; }
  .dateline { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 54px; }
  .dateline div { border-top: 1px solid var(--line); padding-top: 9px; }
  .dateline span, .dateline strong { display: block; }
  .dateline strong { margin-top: 4px; font-size: .92rem; }
  .category-row { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 30px; }
  .article-shell { position: relative; padding-top: 74px; }
  .contents { position: absolute; left: 0; width: min(220px, 18vw); color: var(--muted); font-size: .78rem; line-height: 1.45; }
  .contents ol { margin: 14px 0 0; padding-left: 18px; }
  .contents li { margin-bottom: 8px; }
  .edition-footer { display: flex; align-items: center; justify-content: space-between; gap: 30px; margin-top: 80px; border: solid var(--ink); border-width: 2px 0; padding: 24px 0; }
  .edition-footer p { max-width: 760px; margin: 0; }
  @media (max-width: 1060px) { .contents { position: static; width: min(100%, var(--reading)); margin: 0 auto 50px; border-bottom: 1px solid var(--line); padding-bottom: 20px; } }
  @media (max-width: 700px) { .dateline { grid-template-columns: 1fr; } .edition-footer { align-items: flex-start; flex-direction: column; } }
</style>
