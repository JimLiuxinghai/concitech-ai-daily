---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dateKey, editionPath, formatDate, getDaily, type Language } from '../lib/content';

const { language } = Astro.props as { language: Language };
const isZh = language === 'zh';
const entries = await getDaily(language);
const canonicalPath = isZh ? '/archive/' : '/en/archive/';
const alternatePath = isZh ? '/en/archive/' : '/archive/';
const groups = Map.groupBy(entries, (entry) => dateKey(entry.data.datePT).slice(0, 7));
---

<BaseLayout title={isZh ? '日报归档' : 'Edition archive'} description={isZh ? '浏览 Concitech AI 日报的全部中英文历史版本。' : 'Browse every edition of Concitech AI Daily.'} {language} {canonicalPath} {alternatePath}>
  <header class="page-header shell">
    <div><p class="eyebrow">Archive · {entries.length}</p><h1>{isZh ? '日报归档' : 'Edition archive'}</h1></div>
    <p class="deck">{isZh ? '按太平洋时间归档。每一期保留来源链接、编辑判断与不确定性说明。' : 'Filed by Pacific Time. Every edition preserves source links, editorial judgment and uncertainty notes.'}</p>
  </header>
  <div class="archive shell">
    {[...groups].map(([month, items]) => (
      <section>
        <h2 class="mono">{month}</h2>
        <div>
          {items.map((entry, index) => (
            <a href={editionPath(language, entry.data.datePT)}>
              <span class="number mono">{String(index + 1).padStart(2, '0')}</span>
              <strong>{entry.data.title}</strong>
              <time class="mono" datetime={dateKey(entry.data.datePT)}>{formatDate(entry.data.datePT, language, 'short')}</time>
              <span>↗</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .archive { padding-top: 58px; }
  .archive section { display: grid; grid-template-columns: 150px 1fr; gap: 30px; margin-bottom: 70px; }
  .archive h2 { margin: 8px 0 0; font-size: .8rem; }
  .archive a { display: grid; grid-template-columns: 44px 1fr 180px 20px; gap: 18px; align-items: baseline; border-top: 1px solid var(--ink); padding: 16px 4px; text-decoration: none; }
  .archive a:last-child { border-bottom: 1px solid var(--ink); }
  .archive strong { font-family: 'Newsreader', 'Noto Sans SC', serif; font-size: clamp(1.25rem, 2vw, 1.65rem); }
  .number, time { color: var(--muted); }
  @media (max-width: 760px) { .archive section { grid-template-columns: 1fr; gap: 10px; } .archive a { grid-template-columns: 34px 1fr 18px; } time { display: none; } }
</style>
