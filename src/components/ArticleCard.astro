---
import { articlePath, formatCST, type ArticleEntry } from '../lib/content';

const { entry, featured = false } = Astro.props as { entry: ArticleEntry; featured?: boolean };
---

<a class:list={['article-card', { featured }]} href={articlePath(entry.data.slug)}>
  <img src={entry.data.cover} alt="" width="1200" height="630" loading="lazy" />
  <div class="article-card-copy">
    <p class="mono">深度长文 · {formatCST(entry.data.publishedAtCST, 'zh')}</p>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.description}</p>
    <footer><span>{entry.data.author}</span><span>阅读 ↗</span></footer>
  </div>
</a>

<style>
  .article-card { display: grid; grid-template-columns: minmax(240px, .85fr) minmax(0, 1.15fr); color: inherit; border-top: 4px solid var(--ink); background: var(--paper-bright); text-decoration: none; }
  .article-card:hover { color: inherit; }
  .article-card img { width: 100%; height: 100%; min-height: 270px; object-fit: cover; }
  .article-card-copy { display: flex; flex-direction: column; padding: clamp(22px, 3vw, 38px); }
  .article-card .mono { color: var(--cobalt-dark); }
  .article-card h3 { margin: 22px 0 16px; font-size: clamp(2rem, 3vw, 3.4rem); }
  .article-card p { color: #48545c; }
  .article-card footer { display: flex; justify-content: space-between; margin-top: auto; border-top: 1px solid var(--line); padding-top: 12px; font-size: .84rem; }
  .article-card.featured { grid-column: 1 / -1; }
  @media (max-width: 720px) { .article-card { grid-template-columns: 1fr; } .article-card img { min-height: 0; aspect-ratio: 1200 / 630; } }
</style>
