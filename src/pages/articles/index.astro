---
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles } from '../../lib/content';

const articles = await getArticles();
const title = '深度长文｜Concitech AI';
const description = 'JimLiu 的 AI、Agent、模型、开发工具与前沿科技深度分析归档。';
---

<BaseLayout {title} {description} language="zh" canonicalPath="/articles/">
  <header class="page-header shell">
    <div><p class="eyebrow">Concitech AI · Long reads</p><h1>深度<br />长文</h1></div>
    <p class="deck">不追逐每一个热点，只拆解真正改变产品、工程和产业方向的信号。</p>
  </header>
  <section class="shell article-list">
    <div class="section-rule mono"><span>全部文章</span><span>{String(articles.length).padStart(2, '0')}</span></div>
    <div class="article-grid">
      {articles.map((entry, index) => <ArticleCard {entry} featured={index === 0} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .article-list { padding-bottom: 80px; }
  .article-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 22px; }
  .article-grid :global(.article-card:not(.featured)) { grid-template-columns: 1fr; }
  .article-grid :global(.article-card:not(.featured) img) { aspect-ratio: 1200 / 630; min-height: 0; }
  @media (max-width: 900px) { .article-grid { grid-template-columns: 1fr; } }
</style>
