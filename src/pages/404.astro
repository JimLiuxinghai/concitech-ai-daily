---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 · 页面未找到" description="你访问的页面不存在或已经移动。" language="zh" canonicalPath="/404/" alternatePath="/404/">
  <section class="not-found shell"><p class="eyebrow">Error 404</p><h1>这条信号<br />消失了。</h1><p>页面不存在，或者已经移动到新的位置。</p><a class="button primary" href="/">返回今日日报 →</a></section>
</BaseLayout>
<style>.not-found { min-height: 72vh; padding: 90px 0; }.not-found h1 { margin: 34px 0; }.not-found p:not(.eyebrow) { margin-bottom: 34px; }</style>
