---
import DailyPage from '../../../components/DailyPage.astro';
import { dateKey, getDaily } from '../../../lib/content';

export async function getStaticPaths() {
  return (await getDaily('en')).map((entry) => ({ params: { date: dateKey(entry.data.datePT) }, props: { entry } }));
}

const { entry } = Astro.props;
---
<DailyPage {entry} language="en" />
